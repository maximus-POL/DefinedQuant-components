{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://definedquant.org/schemas/evidence.schema.json",
  "title": "Defined Quant executable component evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "validated_subject_hash",
    "known_answers",
    "invariants",
    "boundary_cases",
    "cross_checks",
    "agent_cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "component_id": {"$ref": "#/$defs/componentId"},
    "validated_subject_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(?:sha256:)?[a-f0-9]{64}$"}
      ]
    },
    "known_answers": {
      "type": "array",
      "items": {"$ref": "#/$defs/knownAnswer"}
    },
    "invariants": {
      "type": "array",
      "items": {"$ref": "#/$defs/invariant"}
    },
    "boundary_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/boundaryCase"}
    },
    "cross_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/crossCheck"}
    },
    "agent_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/agentCase"}
    }
  },
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^dq\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "scalar": {
      "type": ["null", "boolean", "number", "string"]
    },
    "floatFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$float"],
      "properties": {
        "$float": {
          "enum": ["nan", "positive_infinity", "negative_infinity"]
        }
      }
    },
    "repeatFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$repeat"],
      "properties": {
        "$repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "count"],
          "properties": {
            "value": {"$ref": "#/$defs/fixtureValue"},
            "count": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        }
      }
    },
    "plainObject": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!\\$).+"},
      "additionalProperties": {"$ref": "#/$defs/fixtureValue"}
    },
    "fixtureValue": {
      "oneOf": [
        {"$ref": "#/$defs/scalar"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/fixtureValue"}
        },
        {"$ref": "#/$defs/plainObject"},
        {"$ref": "#/$defs/floatFixture"},
        {"$ref": "#/$defs/repeatFixture"}
      ]
    },
    "componentInputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/fixtureValue"}
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^/(?:[a-z][a-z0-9_]*|0|[1-9][0-9]*)(?:/(?:[a-z][a-z0-9_]*|0|[1-9][0-9]*))*$"
    },
    "equalAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op", "value"],
      "properties": {
        "path": {"$ref": "#/$defs/jsonPointer"},
        "op": {"const": "equal"},
        "value": {"$ref": "#/$defs/fixtureValue"}
      }
    },
    "approxAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op", "value", "rtol", "atol"],
      "properties": {
        "path": {"$ref": "#/$defs/jsonPointer"},
        "op": {"const": "approx"},
        "value": {"$ref": "#/$defs/fixtureValue"},
        "rtol": {"type": "number", "minimum": 0},
        "atol": {"type": "number", "minimum": 0}
      }
    },
    "lengthAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op", "value"],
      "properties": {
        "path": {"$ref": "#/$defs/jsonPointer"},
        "op": {"const": "length_equal"},
        "value": {"type": "integer", "minimum": 0}
      }
    },
    "containmentAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op", "value"],
      "properties": {
        "path": {"$ref": "#/$defs/jsonPointer"},
        "op": {"enum": ["contains", "not_contains"]},
        "value": {"$ref": "#/$defs/fixtureValue"}
      }
    },
    "prefixAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op", "value"],
      "properties": {
        "path": {"$ref": "#/$defs/jsonPointer"},
        "op": {"enum": ["contains_prefix", "not_contains_prefix"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "oneOf": [
        {"$ref": "#/$defs/equalAssertion"},
        {"$ref": "#/$defs/approxAssertion"},
        {"$ref": "#/$defs/lengthAssertion"},
        {"$ref": "#/$defs/containmentAssertion"},
        {"$ref": "#/$defs/prefixAssertion"}
      ]
    },
    "successExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "assertions"],
      "properties": {
        "outcome": {"const": "success"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "errorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "code", "violation_ids"],
      "properties": {
        "outcome": {"const": "error"},
        "code": {"type": "string", "minLength": 1},
        "violation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "inputValidationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "inputValidationErrorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "issues"],
      "properties": {
        "outcome": {"const": "input_validation_error"},
        "issues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/inputValidationIssue"}
        }
      }
    },
    "expectation": {
      "oneOf": [
        {"$ref": "#/$defs/successExpectation"},
        {"$ref": "#/$defs/errorExpectation"},
        {"$ref": "#/$defs/inputValidationErrorExpectation"}
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "produced_by", "citation"],
      "properties": {
        "kind": {
          "enum": ["author_derivation", "published", "external_implementation"]
        },
        "produced_by": {"type": "string", "minLength": 1},
        "citation": {"type": "string", "minLength": 1}
      }
    },
    "knownAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "inputs", "expect", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/componentInputs"},
        "expect": {"$ref": "#/$defs/successExpectation"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test_id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "test_id": {"type": "string", "pattern": "^test_[a-zA-Z0-9_]+$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "boundaryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "inputs", "expect"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/componentInputs"},
        "expect": {"$ref": "#/$defs/expectation"}
      }
    },
    "crossCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "inputs", "expect", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/componentInputs"},
        "expect": {"$ref": "#/$defs/successExpectation"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "computeExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "fields"],
      "properties": {
        "action": {"const": "compute"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "askExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "question_fields"],
      "properties": {
        "action": {"const": "ask"},
        "question_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "refuseExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "code", "violation_ids"],
      "properties": {
        "action": {"const": "refuse"},
        "code": {"enum": ["domain_error", "unsupported_scope"]},
        "violation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "agentExpectation": {
      "oneOf": [
        {"$ref": "#/$defs/computeExpectation"},
        {"$ref": "#/$defs/askExpectation"},
        {"$ref": "#/$defs/refuseExpectation"}
      ]
    },
    "agentCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "inputs", "expect", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "prompt": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/componentInputs"},
        "expect": {"$ref": "#/$defs/agentExpectation"},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
