{
  "schema_version": 1,
  "closed": true,
  "outcomes": [
    "needs_information",
    "refused",
    "failed"
  ],
  "redaction_policy": {
    "fixed_messages_only": true,
    "applies_to": [
      "tool_failure_responses",
      "resource_failure_responses",
      "stderr_logs",
      "stored_failure_records"
    ],
    "prohibited_content": [
      "exception text and exception class names",
      "tracebacks and stack frames",
      "absolute filesystem paths and configured root paths",
      "raw input, dataset, result, preview, artifact, and provider values",
      "secrets, credentials, tokens, cookies, authorization headers, and environment values"
    ]
  },
  "details_policy": {
    "default": "exactly_empty_object",
    "schemas": {
      "invalid_tool_request": {
        "required": ["fields"],
        "optional": [],
        "properties": {
          "fields": {"type": "array", "item_type": "field_name", "max_items": 32}
        }
      },
      "unsupported_host_schema": {
        "required": ["requested_version"],
        "optional": [],
        "properties": {
          "requested_version": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
        }
      },
      "unsupported_protocol_version": {
        "required": ["requested_version"],
        "optional": [],
        "properties": {
          "requested_version": {"type": "string", "max_utf8_bytes": 128}
        }
      },
      "unsupported_reference_version": {
        "required": ["requested_version"],
        "optional": [],
        "properties": {
          "requested_version": {"type": "string", "pattern": "^v[0-9]{1,3}$", "max_utf8_bytes": 4}
        }
      },
      "component_not_found": {
        "required": ["component_id"],
        "optional": [],
        "properties": {
          "component_id": {"type": "ComponentId"}
        }
      },
      "component_identity_mismatch": {
        "required": ["component_id"],
        "optional": [],
        "properties": {
          "component_id": {"type": "ComponentId"}
        }
      },
      "missing_convention": {
        "required": ["fields"],
        "optional": [],
        "properties": {
          "fields": {"type": "array", "item_type": "field_name", "max_items": 32}
        }
      },
      "incompatible_ports": {
        "required": ["differences"],
        "optional": [],
        "properties": {
          "differences": {"type": "array", "item_type": "PortDifference", "max_items": 8}
        }
      },
      "invalid_dataset": {
        "required": ["finding_codes"],
        "optional": [],
        "properties": {
          "finding_codes": {"type": "array", "item_type": "SafeId", "max_items": 32}
        }
      },
      "input_limit_exceeded": {
        "required": ["limit_name", "maximum", "actual"],
        "optional": [],
        "properties": {
          "limit_name": {
            "type": "string",
            "enum": [
              "tool_arguments_bytes",
              "inline_json_source_bytes",
              "local_file_bytes",
              "normalized_dataset_payload_bytes",
              "worker_request_bytes",
              "dataset_rows",
              "dataset_columns",
              "decoded_cell_bytes"
            ]
          },
          "maximum": {"type": "integer", "minimum": 0},
          "actual": {"type": "integer", "minimum": 0}
        }
      },
      "invalid_field_mapping": {
        "required": ["fields"],
        "optional": [],
        "properties": {
          "fields": {"type": "array", "item_type": "field_name", "max_items": 32}
        }
      },
      "component_refused": {
        "required": ["component_id"],
        "optional": [],
        "properties": {
          "component_id": {"type": "ComponentId"}
        }
      },
      "component_failed": {
        "required": ["component_id"],
        "optional": [],
        "properties": {
          "component_id": {"type": "ComponentId"}
        }
      },
      "invalid_component_input": {
        "required": ["fields"],
        "optional": [],
        "properties": {
          "fields": {"type": "array", "item_type": "field_name", "max_items": 32}
        }
      },
      "output_validation_failed": {
        "required": ["component_id"],
        "optional": [],
        "properties": {
          "component_id": {"type": "ComponentId"}
        }
      },
      "component_contract_error": {
        "required": [],
        "optional": ["component_id"],
        "properties": {
          "component_id": {"type": "ComponentId"}
        }
      },
      "result_limit_exceeded": {
        "required": ["limit_name", "maximum", "actual"],
        "optional": [],
        "properties": {
          "limit_name": {
            "type": "string",
            "enum": [
              "search_response_bytes",
              "structured_tool_response_bytes",
              "dataset_preview_page_bytes",
              "result_page_bytes",
              "message_page_bytes",
              "artifact_decoded_bytes",
              "resource_response_frame_bytes",
              "normalized_result_member_bytes",
              "result_top_level_fields",
              "operation_artifacts",
              "operation_bundle_bytes",
              "worker_control_response_bytes"
            ]
          },
          "maximum": {"type": "integer", "minimum": 0},
          "actual": {"type": "integer", "minimum": 0}
        }
      },
      "artifact_not_found": {
        "required": ["artifact_id"],
        "optional": [],
        "properties": {
          "artifact_id": {"type": "SafeId"}
        }
      }
    }
  },
  "detail_types": {
    "field_name": {
      "type": "string",
      "max_utf8_bytes": 240,
      "membership": "exact field name declared by the selected closed request schema or verified component model schema",
      "redaction": "Never copy a raw validation location or an unknown, extra, invalid, or overlong request key; omit it instead."
    }
  },
  "host_codes": [
    {
      "code": "invalid_tool_request",
      "outcome": "refused",
      "message": "The request does not satisfy the closed tool schema.",
      "retry_allowed": false,
      "retry_condition": "Correct the request before submitting a new call."
    },
    {
      "code": "unsupported_host_schema",
      "outcome": "refused",
      "message": "The requested host schema version is not supported.",
      "retry_allowed": false,
      "retry_condition": "Use a host schema version declared by this server."
    },
    {
      "code": "unsupported_protocol_version",
      "outcome": "refused",
      "message": "The requested Defined Quant protocol version is not supported.",
      "retry_allowed": false,
      "retry_condition": "Use a protocol version declared compatible by the installed release."
    },
    {
      "code": "unsupported_reference_version",
      "outcome": "refused",
      "message": "The requested content-addressed reference version is not supported.",
      "retry_allowed": false,
      "retry_condition": "Use a reference version declared by this server."
    },
    {
      "code": "component_not_found",
      "outcome": "failed",
      "message": "The requested component is not available in the active catalog.",
      "retry_allowed": false,
      "retry_condition": "Search the active catalog and submit an available component ID."
    },
    {
      "code": "component_identity_mismatch",
      "outcome": "refused",
      "message": "The requested component ID, version, or subject hash does not match the verified installed identity.",
      "retry_allowed": false,
      "retry_condition": "Inspect the component again and submit the exact returned identity."
    },
    {
      "code": "missing_convention",
      "outcome": "needs_information",
      "message": "An answer-changing financial convention must be supplied explicitly.",
      "retry_allowed": false,
      "retry_condition": "Obtain the missing convention from the user before submitting a new call."
    },
    {
      "code": "incompatible_ports",
      "outcome": "refused",
      "message": "The selected output and input semantic ports are not compatible.",
      "retry_allowed": false,
      "retry_condition": "Select a compatible component field mapping before submitting a new call."
    },
    {
      "code": "unsupported_binding",
      "outcome": "refused",
      "message": "The requested data binding form is not supported by this host version.",
      "retry_allowed": false,
      "retry_condition": "Use a literal or one supported immutable source record."
    },
    {
      "code": "multiple_non_literal_sources",
      "outcome": "refused",
      "message": "An operation may use at most one non-literal source record.",
      "retry_allowed": false,
      "retry_condition": "Use one dataset or one upstream operation source before submitting a new call."
    },
    {
      "code": "invalid_dataset",
      "outcome": "refused",
      "message": "The supplied data does not satisfy the closed dataset contract.",
      "retry_allowed": false,
      "retry_condition": "Correct and register the dataset again."
    },
    {
      "code": "unsupported_data_format",
      "outcome": "refused",
      "message": "The supplied data format is not supported.",
      "retry_allowed": false,
      "retry_condition": "Use one of the explicitly supported inline, JSON, or CSV forms."
    },
    {
      "code": "input_root_denied",
      "outcome": "refused",
      "message": "Local file access is not permitted by the configured input roots.",
      "retry_allowed": false,
      "retry_condition": "Use inline data or restart the server with an explicitly configured root."
    },
    {
      "code": "unsafe_input_path",
      "outcome": "refused",
      "message": "The local input path failed closed path and file-type checks.",
      "retry_allowed": false,
      "retry_condition": "Use a regular non-symlink file beneath a configured root."
    },
    {
      "code": "input_limit_exceeded",
      "outcome": "refused",
      "message": "The request or dataset exceeds a configured byte or count limit.",
      "retry_allowed": false,
      "retry_condition": "Reduce the request, file, row, column, or cell size before submitting a new call."
    },
    {
      "code": "invalid_field_mapping",
      "outcome": "refused",
      "message": "The requested source-to-input field mapping is invalid.",
      "retry_allowed": false,
      "retry_condition": "Correct the explicit field mapping before submitting a new call."
    },
    {
      "code": "reference_not_found",
      "outcome": "failed",
      "message": "The requested immutable reference does not exist in the active session.",
      "retry_allowed": false,
      "retry_condition": "Register the dataset or execute the operation again to obtain an active reference."
    },
    {
      "code": "reference_scope_denied",
      "outcome": "refused",
      "message": "The requested immutable reference is not available to the active session scope.",
      "retry_allowed": false,
      "retry_condition": "Use a reference issued within the active session and authorized scope."
    },
    {
      "code": "record_corrupt",
      "outcome": "failed",
      "message": "The immutable stored record failed schema or digest verification and was refused.",
      "retry_allowed": false,
      "retry_condition": "Do not reuse the record; terminate the affected session and create a new record."
    },
    {
      "code": "cache_full",
      "outcome": "failed",
      "message": "The session storage quota cannot accept another immutable record.",
      "retry_allowed": true,
      "retry_condition": "Retry only in a new session or after an operator increases the configured quota."
    },
    {
      "code": "record_publication_failed",
      "outcome": "failed",
      "message": "The immutable host record could not be published safely.",
      "retry_allowed": true,
      "retry_condition": "Retry only after the host storage condition has been resolved."
    },
    {
      "code": "worker_timeout",
      "outcome": "failed",
      "message": "The bounded worker exceeded its wall-clock execution limit.",
      "retry_allowed": true,
      "retry_condition": "Retry only after reducing the workload."
    },
    {
      "code": "worker_cancelled",
      "outcome": "failed",
      "message": "The bounded worker operation was cancelled and its process tree was terminated.",
      "retry_allowed": true,
      "retry_condition": "Retry only when the caller explicitly requests a new execution."
    },
    {
      "code": "worker_crashed",
      "outcome": "failed",
      "message": "The bounded worker exited without a valid typed response.",
      "retry_allowed": true,
      "retry_condition": "Retry at most once after the host replaces the failed worker."
    },
    {
      "code": "worker_capacity",
      "outcome": "failed",
      "message": "The bounded worker concurrency limit is currently occupied.",
      "retry_allowed": true,
      "retry_condition": "Retry only after another worker request has completed."
    },
    {
      "code": "worker_resource_limit",
      "outcome": "failed",
      "message": "The bounded worker exceeded its configured memory or captured-output resource limit.",
      "retry_allowed": false,
      "retry_condition": "Reduce the workload before submitting a new call."
    },
    {
      "code": "component_refused",
      "outcome": "refused",
      "message": "The component refused the requested calculation within its declared scope.",
      "retry_allowed": false,
      "retry_condition": "Change the unsupported request or choose another component before submitting a new call."
    },
    {
      "code": "component_failed",
      "outcome": "failed",
      "message": "The component failed outside its supported refusal protocol.",
      "retry_allowed": false,
      "retry_condition": "Do not retry the unchanged request against the same installed component identity."
    },
    {
      "code": "invalid_component_input",
      "outcome": "refused",
      "message": "The resolved input does not satisfy the component's canonical input model.",
      "retry_allowed": false,
      "retry_condition": "Correct the component input before submitting a new call."
    },
    {
      "code": "output_validation_failed",
      "outcome": "failed",
      "message": "The component output failed its canonical output model or identity checks.",
      "retry_allowed": false,
      "retry_condition": "Do not retry until the installed component implementation is corrected or replaced."
    },
    {
      "code": "component_contract_error",
      "outcome": "failed",
      "message": "The installed component or its declarative contract failed integrity checks.",
      "retry_allowed": false,
      "retry_condition": "Do not retry until the installed catalog or component is corrected."
    },
    {
      "code": "artifact_publication_failed",
      "outcome": "failed",
      "message": "The operation output or declared artifact could not be published safely.",
      "retry_allowed": false,
      "retry_condition": "Do not retry automatically; an operator must resolve the host publication condition."
    },
    {
      "code": "result_limit_exceeded",
      "outcome": "refused",
      "message": "The requested response, page, operation output, or artifact exceeds a configured limit.",
      "retry_allowed": false,
      "retry_condition": "Request a smaller bounded page or reduce the operation output before submitting a new call."
    },
    {
      "code": "artifact_not_found",
      "outcome": "failed",
      "message": "The requested artifact is not declared by the validated operation manifest.",
      "retry_allowed": false,
      "retry_condition": "Use an artifact identifier declared by the validated operation response."
    },
    {
      "code": "internal_failure",
      "outcome": "failed",
      "message": "The host failed internally without a safe domain-specific outcome.",
      "retry_allowed": false,
      "retry_condition": "Do not retry automatically; report the stable host code to the operator."
    }
  ],
  "operation_error_source": "defined_quant_protocol.OperationErrorCode",
  "operation_error_mapping_is_exhaustive": true,
  "operation_error_projection_rules": {
    "empty_fields": {
      "output": {"fields": []},
      "reason": "The runner detail is not a closed MCP request-field projection."
    },
    "component_input_fields": {
      "source_path": ["operation_error", "details", "errors", "*", "loc", 0],
      "target_field": "fields",
      "item_type": "field_name",
      "membership": "verified_component_input_schema_field_names",
      "invalid_or_unknown_items": "omit",
      "order": "source_order",
      "deduplicate": "first_occurrence",
      "max_items": 32,
      "overflow": "take_first_after_deduplication",
      "fallback": []
    },
    "required_component_id": {
      "sources_in_priority_order": [
        ["validated_operation_request", "component", "id"],
        ["operation_error", "component", "id"]
      ],
      "target_field": "component_id",
      "item_type": "ComponentId",
      "on_absent_or_invalid": "map_to_internal_failure_with_empty_details"
    },
    "optional_component_id": {
      "sources_in_priority_order": [
        ["validated_operation_request", "component", "id"],
        ["operation_error", "component", "id"]
      ],
      "target_field": "component_id",
      "item_type": "ComponentId",
      "on_absent_or_invalid": "omit"
    }
  },
  "operation_error_mappings": [
    {
      "operation_error_code": "invalid_operation_request",
      "host_code": "invalid_tool_request",
      "details_projection_rule": "empty_fields"
    },
    {
      "operation_error_code": "invalid_json",
      "host_code": "invalid_tool_request",
      "details_projection_rule": "empty_fields"
    },
    {
      "operation_error_code": "component_not_found",
      "host_code": "component_not_found",
      "details_projection_rule": "required_component_id"
    },
    {
      "operation_error_code": "component_identity_mismatch",
      "host_code": "component_identity_mismatch",
      "details_projection_rule": "required_component_id"
    },
    {
      "operation_error_code": "invalid_component_input",
      "host_code": "invalid_component_input",
      "details_projection_rule": "component_input_fields"
    },
    {
      "operation_error_code": "component_refused",
      "conditional_rules": [
        {
          "priority": 1,
          "source_path": [
            "operation_error",
            "details",
            "component_error",
            "code"
          ],
          "equals": "ambiguous_input",
          "host_code": "missing_convention",
          "details_projection": {
            "source_path": [
              "operation_error",
              "details",
              "component_error",
              "details",
              "questions",
              "*",
              "field"
            ],
            "target_field": "fields",
            "item_type": "field_name",
            "membership": "verified_component_input_schema_field_names",
            "invalid_or_unknown_items": "omit",
            "order": "source_order",
            "deduplicate": "first_occurrence",
            "max_items": 32,
            "overflow": "take_first_after_deduplication",
            "require_non_empty": true,
            "on_absent_or_malformed": "use_default_host_code"
          }
        }
      ],
      "default_host_code": "component_refused",
      "default_details_projection_rule": "required_component_id"
    },
    {
      "operation_error_code": "component_execution_failed",
      "host_code": "component_failed",
      "details_projection_rule": "required_component_id"
    },
    {
      "operation_error_code": "output_validation_failed",
      "host_code": "output_validation_failed",
      "details_projection_rule": "required_component_id"
    },
    {
      "operation_error_code": "component_contract_error",
      "host_code": "component_contract_error",
      "details_projection_rule": "optional_component_id"
    },
    {
      "operation_error_code": "invalid_output_directory",
      "host_code": "artifact_publication_failed"
    },
    {
      "operation_error_code": "output_exists",
      "host_code": "artifact_publication_failed"
    },
    {
      "operation_error_code": "artifact_write_failed",
      "host_code": "artifact_publication_failed"
    },
    {
      "operation_error_code": "operation_failed",
      "host_code": "internal_failure"
    }
  ],
  "allowed_codes_by_surface": {
    "search_components": [
      "invalid_tool_request",
      "unsupported_host_schema",
      "input_limit_exceeded",
      "component_contract_error",
      "result_limit_exceeded",
      "internal_failure"
    ],
    "inspect_component": [
      "invalid_tool_request",
      "unsupported_host_schema",
      "input_limit_exceeded",
      "component_not_found",
      "component_identity_mismatch",
