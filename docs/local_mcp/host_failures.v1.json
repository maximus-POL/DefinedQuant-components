      "unsupported_binding",
      "multiple_non_literal_sources",
      "invalid_dataset",
      "input_limit_exceeded",
      "invalid_field_mapping",
      "reference_not_found",
      "reference_scope_denied",
      "record_corrupt",
      "cache_full",
      "record_publication_failed",
      "worker_timeout",
      "worker_cancelled",
      "worker_crashed",
      "worker_capacity",
