      "internal_failure"
    ],
    "get_operation": [
      "invalid_tool_request",
      "unsupported_host_schema",
      "input_limit_exceeded",
      "unsupported_protocol_version",
      "unsupported_reference_version",
      "reference_not_found",
      "reference_scope_denied",
